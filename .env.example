# =============================================================================
# Trinova AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# =============================================================================


# -----------------------------------------------------------------------------
# Backend API — required
# -----------------------------------------------------------------------------
# Base URL of the ASP.NET Core backend, WITHOUT a trailing slash.
# The Inventory AI will call:
#   GET {INVENTORY_API_BASE_URL}/inventory/forecast-dataset
#
# Examples:
#   Local backend running on port 5000:
#     INVENTORY_API_BASE_URL=http://localhost:5000/api
#   Azure App Service / Container App:
#     INVENTORY_API_BASE_URL=https://trinova-backend.azurewebsites.net/api

INVENTORY_API_BASE_URL=https://trinova-backend.azurewebsites.net/api


# -----------------------------------------------------------------------------
# Authentication — optional
# -----------------------------------------------------------------------------
# Bearer token or API key forwarded as:  Authorization: Bearer <value>
# Leave blank if the backend endpoint is publicly accessible or uses
# network-level security (VNet / IP allow-list).

API_KEY=


# -----------------------------------------------------------------------------
# HTTP client tuning — optional (defaults shown)
# -----------------------------------------------------------------------------
# REQUEST_TIMEOUT : seconds to wait for a response before aborting
# MAX_RETRIES     : number of retries on transient 5xx / network errors
# RETRY_BACKOFF   : base back-off in seconds (doubles on each retry)

REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF=1.0


# -----------------------------------------------------------------------------
# App config
# -----------------------------------------------------------------------------
PORT=8080
