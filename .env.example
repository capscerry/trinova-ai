INVENTORY_API_BASE_URL=https://trinova-erp-backend-production-2.up.railway.app/api


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# The /api/inventory/forecast-dataset endpoint is [AllowAnonymous] — no JWT
# or API key is required.  Leave API_KEY empty.
#
# If a future endpoint requires authentication, set API_KEY to a valid
# bearer token obtained from POST /api/auth/login on the backend.
# The client will then send: Authorization: Bearer <API_KEY>
# -----------------------------------------------------------------------------

API_KEY=


# -----------------------------------------------------------------------------
# HTTP client tuning — optional (defaults shown)
# -----------------------------------------------------------------------------
# REQUEST_TIMEOUT : seconds to wait for a response before aborting
# MAX_RETRIES     : number of retries on transient 5xx / network errors
# RETRY_BACKOFF   : base back-off in seconds (doubles on each retry)

REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF=1.0


# -----------------------------------------------------------------------------
# App config
# -----------------------------------------------------------------------------
PORT=8080
