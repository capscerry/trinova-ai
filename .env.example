# =============================================================================
# Trinova AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# =============================================================================


# -----------------------------------------------------------------------------
# OPTION A — Discrete variables (recommended, no parsing ambiguity)
# -----------------------------------------------------------------------------
# These take priority over SQL_CONNECTION_STRING_DEV.
#
# DB_SERVER   : Azure SQL server hostname (without tcp: prefix — added at runtime)
# DB_NAME     : Database name
# DB_UID      : Full Azure SQL username  →  user@admin@server-name
#               ^^^^^^ The full form including the @server-name suffix is REQUIRED
#               by Azure SQL for SQL authentication.  Do NOT shorten it.
# DB_PWD      : Password.  Special characters (including @) are safe here because
#               config.py inserts the value directly into the pyodbc key=value
#               string — no URL encoding needed.

DB_SERVER=trinova-server-2.database.windows.net
DB_NAME=trinova-backup
DB_UID=trinova@admin@trinova-server-2
DB_PWD=capstoneckrtgr11@


# -----------------------------------------------------------------------------
# OPTION B — Single ADO.NET-style connection string (legacy / fallback)
# -----------------------------------------------------------------------------
# config.py will PARSE this string and REBUILD it as a valid pyodbc string.
# It is NOT passed to pyodbc directly (doing so drops the username — see below).
#
# IMPORTANT FORMAT NOTES:
#   ✓  Use "User Id="  OR  "UID="  — both are parsed correctly
#   ✓  TrustServerCertificate=True  is accepted (converted to yes internally)
#   ✗  Do NOT rely on this string being forwarded verbatim to pyodbc
#
# WHY THE RAW STRING FAILS:
#   pyodbc does not recognise "User Id=" — it expects "UID=".
#   Passing the raw ADO.NET string causes pyodbc to silently drop the username,
#   so Azure SQL receives no UID → Login failed (18456).
#
# Only set this if you are NOT setting the discrete DB_* vars above.

# SQL_CONNECTION_STRING_DEV=Server=trinova-server-2.database.windows.net;Database=trinova-backup;User Id=trinova@admin@trinova-server-2;Password=capstoneckrtgr11@;TrustServerCertificate=True;


# -----------------------------------------------------------------------------
# What config.py builds at runtime (for reference — do not set this manually)
# -----------------------------------------------------------------------------
# DRIVER={ODBC Driver 18 for SQL Server};
# SERVER=tcp:trinova-server-2.database.windows.net,1433;
# DATABASE=trinova-backup;
# UID=trinova@admin@trinova-server-2;
# PWD=capstoneckrtgr11@;
# Encrypt=yes;
# TrustServerCertificate=yes;
# Connection Timeout=30;
# -----------------------------------------------------------------------------
